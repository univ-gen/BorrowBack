<resources>
    <style name="BBTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/bb_text</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="BBHeading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/bb_text</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>
    <style name="BBBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/bb_muted</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>
    <style name="BBLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/bb_text</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>
    <style name="BBInput" parent="Widget.AppCompat.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/bb_text</item>
        <item name="android:textColorHint">@color/bb_muted</item>
        <item name="android:padding">10dp</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="BBButton" parent="Widget.AppCompat.Button.Colored">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/bb_surface</item>
        <item name="backgroundTint">@color/bb_primary</item>
    </style>
    <style name="BBBack" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/bb_primary</item>
    </style>
    <style name="BBSecondaryButton" parent="BBButton">
        <item name="android:textColor">@color/bb_primary</item>
        <item name="backgroundTint">@color/bb_soft</item>
    </style>
</resources>
