<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                style="@style/BBTitle"
                android:text="@string/app_name"
                android:layout_marginTop="16dp" />
            <TextView
                style="@style/BBBody"
                android:text="@string/home_summary"
                android:layout_marginBottom="28dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginBottom="18dp">
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/bb_soft">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:id="@+id/txtLoanCount"
                            style="@style/BBTitle"
                            android:textColor="@color/bb_primary" />
                        <TextView
                            style="@style/BBBody"
                            android:text="@string/active_loans"
                            android:layout_marginBottom="0dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/bb_soft">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:id="@+id/txtOverdueCount"
                            style="@style/BBTitle"
                            android:textColor="@color/bb_primary" />
                        <TextView
                            style="@style/BBBody"
                            android:text="@string/overdue_loans"
                            android:layout_marginBottom="0dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
            <Button
                android:id="@+id/btnAddLoan"
                style="@style/BBButton"
                android:text="@string/add_loan"
                android:layout_marginBottom="12dp"
                android:minHeight="56dp" />
            <Button
                android:id="@+id/btnAllLoans"
                style="@style/BBSecondaryButton"
                android:text="@string/all_loans"
                android:layout_marginBottom="12dp"
                android:minHeight="56dp" />
            <Button
                android:id="@+id/btnSearchLoans"
                style="@style/BBSecondaryButton"
                android:text="@string/search_loans"
                android:layout_marginBottom="12dp"
                android:minHeight="56dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
